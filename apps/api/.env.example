# Local Postgres (docker / installed). On Vercel, set this in Project Settings
# to a hosted pooled URL (Neon/Supabase/Railway pooler), not localhost.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bdrms

# Use a long random value in production (Vercel env, not this file).
JWT_SECRET=replace-with-strong-secret

# Local only. Vercel sets PORT; do not add PORT in Vercel env vars.
PORT=4000
